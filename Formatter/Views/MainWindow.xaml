<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Formatter.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Formatter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Formatter"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Formatter">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Grid Grid.Row="1">
            <NavigationView 
                IsBackEnabled="False"
                IsBackButtonVisible="Collapsed">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Извещение"/>
                </NavigationView.MenuItems>
                <Frame x:Name="RootFrame" />
            </NavigationView>
        </Grid>
    </Grid>
</Window>